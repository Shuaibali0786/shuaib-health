# Backend configuration template. Copy to .env (git-ignored) and fill in real values there.
# Never commit .env and never paste real URLs into chats, issues or logs.

# development | test | production
APP_ENV=development

# Dev database, POOLED connection (Neon host contains "-pooler"). Used by the running app.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Dev database, DIRECT connection (same database, host WITHOUT "-pooler"). Used by Alembic migrations.
DIRECT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=require

# Separate TEST database, DIRECT connection. Must differ from both URLs above. Tests migrate and wipe it.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-example-test.REGION.aws.neon.tech/DBNAME_TEST?sslmode=require

# Allowed browser origins, comma-separated. "*" is rejected.
CORS_ORIGINS=http://localhost:3000

# Requests per minute per client IP on public endpoints.
RATE_LIMIT_PER_MINUTE=60

# Number of trusted reverse proxies in front of the app (0 = ignore X-Forwarded-For).
TRUSTED_PROXY_HOPS=0

# Cache-Control max-age for public catalog responses, in seconds.
CACHE_MAX_AGE_SECONDS=300

# Prefix joined with stored image keys to build image URLs.
IMAGE_BASE_PATH=/images/

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Booking (Feature 005). Both secrets are required, at least 32 characters; the app refuses to start without them.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BOOKING_PROXY_SECRET must equal the website's BOOKING_PROXY_SECRET (server-only).
BOOKING_PROXY_SECRET=
PRIVACY_HASH_KEY=

# Demo site: bookings are labelled as samples and purged automatically.
DEMO_MODE=true
# Demo bookings are purged this many days after the appointment (1-90).
BOOKING_PURGE_AFTER_DAYS=7
# Audit rows are purged after this many days (7-365).
AUDIT_PURGE_AFTER_DAYS=90
# Booking limits (shared in Postgres): attempts per IP per hour, per mobile per day, lookups per IP per minute.
BOOKING_LIMIT_PER_IP_PER_HOUR=10
BOOKING_LIMIT_PER_PHONE_PER_DAY=5
LOOKUP_LIMIT_PER_IP_PER_MINUTE=20

# Command Centre (Feature 006). SESSION_SECRET is required, at least 32 characters; the app refuses to start without it.
# It keys the session-token and CSRF HMACs; rotating it signs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Optional tunables (defaults shown).
# STAFF_IDLE_MINUTES=30
# STAFF_ABSOLUTE_HOURS=12
# STAFF_MAX_SESSIONS=3
# LOGIN_LOCK_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# LOGIN_LIMIT_PER_IP_PER_15MIN=20
# DEMO_LIMIT_PER_IP_PER_HOUR=10
# DEMO_SESSION_HOURS=2
# STATUS_UNDO_SECONDS=10
