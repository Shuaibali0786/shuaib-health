# Optional. Public base URL used for the sitemap and canonical links.
# The build works without it (defaults to http://localhost:3000).
SITE_URL=http://localhost:3000

# Server-only. Base URL of the catalog API (Feature 003). The build works when it is unset.
CATALOG_API_URL=http://localhost:8000

# Server-only. JSON of the clinic settings (see contracts/data-access.md section 4).
# Used only when clinic settings have never loaded; the build works when it is unset.
CLINIC_FALLBACK_JSON=

# Tests only. Leave unset (default 300).
CATALOG_DATA_REVALIDATE_SECONDS=

# Optional. `false` removes the demo dashboard from the website (gold top bar, demo buttons, /admin/demo/start).
# Use the same value as the backend's DEMO_ENABLED. Read when the public pages are built, so set it before `npm run build`.
DEMO_ENABLED=true

# Feature 010: the chat assistant ("Ask us"). OFF unless set to true. Read at build time, like DEMO_ENABLED.
# No key is needed: v1 answers from the site's own data in the browser (ADR-0013).
# ASSISTANT_ENABLED=false
# Feature 010 v1.1: which engine answers. local (default) = the free built-in engine. claude = the free engine
# first, then the API's optional Claude provider for unknown questions (also needs ASSISTANT_AI_ENABLED and
# ANTHROPIC_API_KEY on the API). See docs/runbooks/ai-provider.md.
# ASSISTANT_PROVIDER=local

# Server-only. Must equal the backend's BOOKING_PROXY_SECRET (at least 32 characters).
# `next start` refuses to start without it; the build does not need it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_PROXY_SECRET=

# ---- Launch settings (007). Production is Vercel; see specs/007-launch-ready/contracts/required-settings.md ----
# On Vercel (production and preview) DEMO_ENABLED must be set explicitly (above). SITE_URL is resolved from
# SITE_URL, then VERCEL_PROJECT_PRODUCTION_URL (production) or VERCEL_URL (preview); a production build with
# neither fails. SITE_URL must be https and not localhost on Vercel.

# Security headers: off (default) | report | enforce. Production starts with `report`, then `enforce` after one clean release.
# Read by code added in the next pull request.
SITE_SECURITY_HEADERS=off

# Optional. The Sentry "security" endpoint of the website project (Sentry -> Project settings -> Security Headers).
# Browsers send CSP violation reports there. Leave empty for no reporting. Plain https URL only.
CSP_REPORT_URI=

# Server-only, Vercel Preview scope only: the API project's "Protection Bypass for Automation" value.
# Sent as x-vercel-protection-bypass on server-side API calls. Leave unset in Production.
# Read by code added in the next pull request.
API_PROTECTION_BYPASS=

# Error tracking (added in a later pull request). Unset = off.
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Feature 013 (voice receptionist, Phase 1). OFF unless true/1/yes/on. Needs ASSISTANT_ENABLED. Read at build
# time. Free browser speech only; no paid service. Production stays off until the owner approves.
# VOICE_ENABLED=false
# VOICE_PROVIDER=browser   # "azure" = premium neural voices and listening (needs AZURE_SPEECH_* on the API); falls back silently
# VOICE_BRAIN=rules        # "gemini" = optional AI brain for turns the rules do not understand (never books); falls back silently
# GEMINI_API_KEY=          # server only, Sensitive in Vercel; a Google AI Studio key from a project WITHOUT billing (free tier)
# GEMINI_MODEL=gemini-2.5-flash
