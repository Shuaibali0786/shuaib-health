{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test -c playwright.offline.config.ts",
    "test:e2e:stateful": "playwright test -c playwright.stateful.config.ts",
    "api:types": "openapi-typescript ../specs/003-catalog-api/contracts/openapi.yaml -o src/lib/api/schema.gen.ts",
    "api:record": "node scripts/record-api-fixtures.mjs",
    "mock-api": "node tests/mock-api/server.mjs",
    "images": "node scripts/images.mjs",
    "images:placeholders": "node scripts/generate-placeholder-images.mjs",
    "export:catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-catalog.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
